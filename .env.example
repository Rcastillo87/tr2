APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos de TR2: PostgreSQL con TimescaleDB
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=trading2
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Horizon solo funciona con Redis
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# TR2 - motor Python, watchdog y riesgo (los valores comentados son los de por defecto)
# El motor Python tiene su propio archivo: python-engine/.env (ver python-engine/.env.example)
# =============================================================================

# Motor Python (FastAPI)
PYTHON_ENGINE_URL=http://127.0.0.1:8002
# Clave compartida Laravel <-> motor. Debe ser IGUAL a INTERNAL_API_KEY de python-engine/.env
# Generar una: openssl rand -hex 32
PYTHON_INTERNAL_API_KEY=

# Watchdog: reinicio automatico de servicios (apagado por defecto)
WATCHDOG_RESTART_ENGINE=false
WATCHDOG_RESTART_HORIZON=false
# WATCHDOG_FAILS_TO_RESTART=3
# WATCHDOG_RESTART_COOLDOWN_S=1800
# WATCHDOG_QUEUE_STALE_S=300
# WATCHDOG_SERIES_GRACE_S=300
# WATCHDOG_REAL_TICK_STALE_S=180

# Limites de riesgo por cuenta (por defecto, editables por el dueno en /trading/accounts)
# RISK_MAX_MONTHLY_LOSS_PCT=5
# RISK_MAX_OPEN_TRADES=3

# Avisos de broker
# BROKER_EVENTS_RETENTION_DAYS=90
# BROKER_EVENTS_THROTTLE_MINUTES=60

# Cuentas demo para inversionistas
# ALLOW_INVESTOR_DEMO_ACCOUNTS=false
