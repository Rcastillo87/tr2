# Motor Python de TR2: copiar a python-engine/.env  (el .env real NO se versiona; permisos 600)

# PostgreSQL / TimescaleDB
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=trading2
DB_USER=
DB_PASSWORD=

# Clave compartida con Laravel: debe ser IGUAL a PYTHON_INTERNAL_API_KEY del .env de Laravel
# Generar una: openssl rand -hex 32
INTERNAL_API_KEY=

# MISMO valor que APP_KEY del .env de Laravel. Sirve para descifrar las claves de broker
# guardadas por Laravel (trading/laravel_crypt.py). Si no coincide, el motor no puede operar en real.
APP_KEY=

REDIS_URL=redis://127.0.0.1:6379

# Bybit (mainnet y demo trading)
BYBIT_BASE_URL=https://api.bybit.com
# BYBIT_DEMO_URL=https://api-demo.bybit.com

# Collector: las series salen SOLO de collector_configs (C-01, 2026-11-03); SYMBOLS / INTERVALS ya no se usan.
# Auditoría histórica rotativa contra Bybit (C-03): consultas por noche (~5 min con 1500; todo el histórico cada ~12 días)
COLLECTOR_AUDIT_BUDGET=1500

# Paper: horas que se espera la reparación de un hueco dentro del 1m antes de evaluarlo con la vela completa (BP-03)
PAPER_MINUTE_GAP_WAIT_HOURS=26
